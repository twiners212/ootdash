{
  "name": "ootdash-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm install --prefix client && npm run build --prefix client && cp -r client/dist ./dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
